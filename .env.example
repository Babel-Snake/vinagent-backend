# Server Configuration
PORT=4000
NODE_ENV=development
# Production requires one exact HTTPS frontend origin (no path or comma-separated list).
CORS_ORIGIN=http://localhost:3000
# Required in production. Public backend origin for HTTPS redirects and webhook signatures.
PUBLIC_URL=http://localhost:4000
# Required in production. Public frontend origin used for customer-facing secure links.
PUBLIC_APP_URL=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RESOLVE_STAFF_RATE_LIMIT_WINDOW_MS=900000
RESOLVE_STAFF_RATE_LIMIT_MAX=20
PIN_LOGIN_RATE_LIMIT_WINDOW_MS=900000
PIN_LOGIN_RATE_LIMIT_MAX=20
JSON_BODY_LIMIT=10mb
OUTBOUND_HTTP_TIMEOUT_MS=10000
AI_HTTP_TIMEOUT_MS=30000
WEBHOOK_BODY_LIMIT=1mb
WEBHOOK_RATE_LIMIT_WINDOW_MS=900000
WEBHOOK_RATE_LIMIT_MAX=1000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=vinagent
DB_PASSWORD=vinagent
DB_NAME=vinagent_dev
DB_DIALECT=mysql

# Firebase Admin Credential
# Required in production. The backend initializes Firebase Admin from these env vars.
# A local src/config/serviceAccountKey.json file is supported only as an ignored dev fallback.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# Firebase Client Config (for local auth validation and debug scripts)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Local/Staging Utility Script Credentials
SEED_USER_PASSWORD=
TEST_AUTH_EMAIL=test.admin@vinagent.com
TEST_AUTH_PASSWORD=
DEBUG_LOGIN_EMAIL=
DEBUG_LOGIN_PASSWORD=
# Optional Sidewood seed overrides. Leave blank to preserve existing users and
# generate one-time credentials only for newly created demo accounts.
SIDEWOOD_MANAGER_PASSWORD=
SIDEWOOD_STAFF_ACCESS_CODE=
# Development/rehearsal only: seed database users without changing Firebase.
SIDEWOOD_DB_ONLY=false

# Auth Security
ALLOW_TEST_AUTH_BYPASS=false
# Locks every login and public staff/PIN flow to one winery. Required in
# production; only a deployment operator should change this value.
DEPLOYMENT_WINERY_ID=

# One-off fresh-pilot bootstrap inputs. Set these only while running
# `npm run pilot:bootstrap`, then remove them from the deployment environment.
# Do not use this bootstrap over an imported winery database.
PILOT_WINERY_NAME=
PILOT_WINERY_TIME_ZONE=Australia/Adelaide
PILOT_WINERY_CONTACT_EMAIL=
PILOT_ADMIN_FIREBASE_UID=
PILOT_ADMIN_EMAIL=
PILOT_ADMIN_DISPLAY_NAME=

# Required in production. Use a high-entropy value of at least 32 characters.
PIN_SESSION_SECRET=
# Fallback session secret. Also accepted for PIN signing when PIN_SESSION_SECRET is absent.
SESSION_SECRET=

# AI Service (OpenAI)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
AI_SKIP=false
AI_ALLOW_LIVE_TESTS=false
# Local development only. Production always refuses mock booking/CRM execution.
ALLOW_MOCK_INTEGRATIONS=true

# Twilio (SMS & Webhooks)
# Required in production for outbound SMS and Twilio webhook signature validation.
# If any value is missing in production, outbound SMS fails closed instead of using mock mode.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+15551234567
# Required for Retell callback verification. Use the Retell API key marked for
# webhook authentication. RETELL_WEBHOOK_SECRET remains a legacy fallback.
RETELL_API_KEY=key_...
# Required in production for email webhook intake.
EMAIL_WEBHOOK_SECRET=

# Attachments
ATTACHMENT_MAX_BYTES=5242880
# Required in production: an existing absolute directory that is readable and
# writable by the API process. Coolify API image: mount a persistent volume at
# /app/data/attachments and set this value to the same path.
ATTACHMENT_STORAGE_ROOT=

# Unauthenticated container probes. Readiness is cached briefly to prevent
# repeated public probes from amplifying database load.
HEALTH_READINESS_TIMEOUT_MS=5000
HEALTH_READINESS_CACHE_MS=2000

# Maximum time allowed for HTTP draining and database shutdown on SIGTERM.
SHUTDOWN_TIMEOUT_MS=10000

# Logging
LOG_LEVEL=info
ENABLE_TELEMETRY=false

# Billing-ready product usage metering. Gauges are idempotently refreshed by
# the API scheduler; payment/export enforcement is not enabled in the pilot.
USAGE_SNAPSHOT_INTERVAL_MS=3600000

# Task Deadline Reminders
TASK_DEADLINE_REMINDERS_ENABLED=true
TASK_DEADLINE_DUE_SOON_HOURS=48
TASK_DEADLINE_OVERDUE_REPEAT_HOURS=24
TASK_DEADLINE_MANAGER_ESCALATION_HOURS=24
TASK_DEADLINE_SCHEDULER_INTERVAL_MS=900000
TASK_DEADLINE_BATCH_SIZE=100

# Operational Intelligence Scheduler
# Disabled by default because it persists advisory review records.
OPERATIONAL_INTELLIGENCE_SCHEDULER_ENABLED=false
OPERATIONAL_INTELLIGENCE_SCHEDULER_INTERVAL_MS=21600000
OPERATIONAL_INTELLIGENCE_SCHEDULER_PERIOD=day
OPERATIONAL_INTELLIGENCE_SCHEDULER_OFFSET=0
OPERATIONAL_INTELLIGENCE_SCHEDULER_RUN_IMMEDIATELY=false
OPERATIONAL_INTELLIGENCE_REVIEW_DUE_SOON_HOURS=48
OPERATIONAL_INTELLIGENCE_REVIEW_OVERDUE_REPEAT_HOURS=24
OPERATIONAL_INTELLIGENCE_REVIEW_REMINDER_BATCH_SIZE=100

# SendGrid Email
# If SendGrid is selected without an API key in production, outbound email fails closed.
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=noreply@vinagent.local

# Outlook / Microsoft Graph Email Sync
OUTLOOK_GRAPH_TENANT_ID=
OUTLOOK_GRAPH_CLIENT_ID=
OUTLOOK_GRAPH_CLIENT_SECRET=
OUTLOOK_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
OUTLOOK_GRAPH_TOKEN_BASE_URL=https://login.microsoftonline.com
EMAIL_SYNC_ENABLED=false
EMAIL_SYNC_INTERVAL_MS=300000
EMAIL_SYNC_MAX_MESSAGES=25
EMAIL_SYNC_INITIAL_LOOKBACK_HOURS=24
