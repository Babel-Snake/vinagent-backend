{
  "name": "vinagent-backend",
  "version": "0.1.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=10 <12"
  },
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "start:worker": "node src/integrationWorker.js",
    "test": "jest",
    "test:unit": "jest --runInBand src/tests/unit",
    "test:int": "jest --runInBand src/tests/integration",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "preflight:deployment": "node src/scripts/deploymentPreflight.js",
    "pilot:bootstrap": "node src/scripts/pilotBootstrap.js",
    "pilot:disable-unsupported-modules": "node src/scripts/disableUnsupportedPilotModules.js",
    "seed:sidewood": "node src/scripts/seedSidewoodEstate.js",
    "seed:sidewood:projects": "node src/scripts/seedSidewoodProjects.js",
    "smoke:sidewood": "node src/scripts/verifySidewoodProductionReadiness.js",
    "smoke:sidewood:firebase": "node src/scripts/verifySidewoodProductionReadiness.js --verify-firebase"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "overrides": {
    "uuid": "11.1.1"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "axios": "^1.18.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.1.0",
    "helmet": "^8.2.0",
    "joi": "^17.13.4",
    "morgan": "^1.11.0",
    "mysql2": "^3.22.6",
    "openai": "^6.46.0",
    "sequelize-cli": "^6.6.5",
    "sequelize": "^6.37.7",
    "twilio": "^5.13.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "globals": "^14.0.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "sqlite3": "^6.0.1",
    "supertest": "^7.2.2"
  }
}
